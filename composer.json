{
  "name": "mupag/mupag-sdk",
  "description": "SDK oficial PHP para integrar a API publica da MuPag.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.mupag.com.br",
  "keywords": [
    "mupag",
    "payments",
    "pix",
    "php",
    "sdk"
  ],
  "authors": [
    {
      "name": "MuPag",
      "homepage": "https://mupag.com.br"
    }
  ],
  "support": {
    "docs": "https://docs.mupag.com.br",
    "source": "https://github.com/mupaybr/mupag-sdk-php"
  },
  "archive": {
    "exclude": [
      "/.env",
      "/.phpunit.cache/",
      "/AGENTS.md",
      "/build/",
      "/tests/",
      "/vendor/"
    ]
  },
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.9",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "MuPag\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MuPag\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-clover build/logs/clover.xml",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
